# Supabase (required for online rooms; the production build works without them,
# but gameplay APIs return a clear NOT_CONFIGURED error until these are set).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_* and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
